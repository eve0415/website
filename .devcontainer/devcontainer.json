{
  "name": "eve0415 website devcontainer",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5.0.3-24-trixie",
  "postStartCommand": "pnpm install --frozen-lockfile && pnpm generate && pnpm playwright install --with-deps",
  "containerEnv": {
    "TZ": "Asia/Tokyo"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {
      "extensions": "github/gh-stack",
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
  }
}
