{
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously && oxfmt",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate": "wrangler types",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/vitest-plugin": "https://pkg.pr.new/@cloudflare/vitest-plugin@7b89dc4",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@marsidev/react-turnstile": "1.6.1",
    "@oxlint/plugins": "1.83.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.56",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "5.0.1",
    "oxc-transform-react": "0.150.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tailwindcss": "1.12.0",
    "oxlint-tsgolint": "7.0.2002",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "subset-font": "2.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-devtools-json": "1.1.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "pnpm@12.5.1"
}
