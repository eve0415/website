{
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously && oxfmt",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate": "wrangler types",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/vitest-plugin": "1.1.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@marsidev/react-turnstile": "1.6.0",
    "@oxlint/plugins": "1.80.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.49",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "oxc-transform-react": "0.147.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tailwindcss": "1.10.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "subset-font": "2.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-devtools-json": "1.1.0",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
