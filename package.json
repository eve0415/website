{
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously && oxfmt",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate": "wrangler types --env-file .dev.vars.example && node cn-tables.config.ts",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "cn": "0.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@marsidev/react-turnstile": "1.6.2",
    "@oxlint/plugins": "1.88.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "oxc-transform-react": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tailwindcss": "1.16.0",
    "oxlint-tsgolint": "7.0.2004",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-devtools-json": "1.1.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
