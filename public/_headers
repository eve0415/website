# The 20 prerendered pages are served straight off Cloudflare's asset server, so
# the Worker — and therefore the request middleware in src/start.ts — never runs
# for them. This is the same policy that middleware sets, byte for byte, and the
# two have to be changed together; there is no build step that checks it.
# It is a static file, so a per-request nonce is impossible here by construction
# and the middleware deliberately does not use one either.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# HTML is left out of every rule below on purpose: a prerendered page is
# rewritten on each deploy while its content-hashed assets are not.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/:file.ico
  Cache-Control: public, max-age=86400

/:file.png
  Cache-Control: public, max-age=86400

/:file.jpg
  Cache-Control: public, max-age=86400

/:file.svg
  Cache-Control: public, max-age=86400

/:file.webmanifest
  Cache-Control: public, max-age=86400

/:file.txt
  Cache-Control: public, max-age=86400
